# ignore virtual environments
venv/
.venv/
env/

# ignore outputs
*.csv
*.parquet
*.pbf
*.geojson
*.geojson.gz
*.feather

# ignore large notebooks with output (optional)
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ignore Jupyter lab stuff
.jupyter/

# ignore git
.git
.gitignore

.env

# Secrets: nie ins Image backen. Zur Laufzeit liegt das Repo per Bind-Mount
# unter /app, der Token kommt also ohnehin vom Host - im Image-Layer würde er
# nur jede spätere Änderung überleben.
config.json
config.py
**/config_mapillary_privat.json

# ignore docker files
# docker/

# ignore data directories, if exist
data/
output/
use_cases/
cache/
archive/

!prep/bundeslaender.geojson
!use_cases/utils/*motorways*.parquet

# ignore everything that shouldn't be in the Docker image
schrott/
logs/
*.gpkg
*.fgb
*.log
