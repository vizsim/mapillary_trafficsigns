# Vorlage für docker/.env (gitignored). Werte eintragen und Datei kopieren:
#   cp docker/.env.example docker/.env

# --- NordVPN (gluetun) ---
NORD_USER=servercred_user
NORD_PASS=servercred_pw

# --- Backblaze B2: Archiv für schwere Outputs (Parquets) ---
# Genutzt von scripts/upload_outputs_to_b2.sh, um die aus git entfernten
# ts-Parquets nach b2://vizsim-public-archive/mapillary_trafficsigns/ zu syncen.
#
#   Allow access to Bucket: vizsim-public-archive, Type: Read and Write.
B2_ARCHIVE_KEY_ID=keyID_hier
B2_ARCHIVE_KEY=applicationKey_hier

# --- gluetun-Steuer-API ---
# Frei wählbares Passwort für die lokale Steuer-API des VPN-Containers
# (Port 8000), z. B.: openssl rand -hex 32
# Der Worker verbindet damit den Tunnel neu, wenn ein Exit keine gültigen
# Tile-Antworten mehr liefert (mapillary_tiles.reconnect_vpn).
# Leer lassen = Reconnect deaktiviert.
GLUETUN_API_KEY=
