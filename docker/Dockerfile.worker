FROM python:3.12-slim

# Basis-Settings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# # Systempakete (git, osmium-tool)
# RUN apt-get update \
#     && apt-get install -y --no-install-recommends \
#        git \
#        osmium-tool \
#     && rm -rf /var/lib/apt/lists/*

# Systempakete (tippecanoe)
ARG TIPPECANOE_VERSION=2.78.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates make g++ zlib1g-dev libsqlite3-dev \
 && git clone --depth 1 --branch "${TIPPECANOE_VERSION}" https://github.com/felt/tippecanoe.git /tmp/tippecanoe \
 && make -C /tmp/tippecanoe -j"$(nproc)" \
 && make -C /tmp/tippecanoe install \
 && rm -rf /tmp/tippecanoe \
 && apt-get purge -y --auto-remove git make g++ \
 && rm -rf /var/lib/apt/lists/*




# Python environment, installed from uv.lock - the same lock file as for local
# work and CI. It lives in /opt/venv, not /app/.venv: docker-compose.yml
# bind-mounts the whole repo over /app at runtime, which would hide anything the
# image put there. PATH puts its python3 and jupyter first, so the runner and
# nbconvert use it without further changes.
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache

# Restliches Repo
COPY . .

# Overridden per service in docker-compose.yml.
CMD ["bash", "scripts/run_mapillary_notebooks.sh", "ts"]
